{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "vitest/globals", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["app", "db", "domain", "lib", "src", "tests", "vite.config.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
